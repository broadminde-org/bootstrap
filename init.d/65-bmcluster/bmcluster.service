[Unit]
Description=Broadminde cluster membership (operator activation required)
After=network-online.target
Wants=network-online.target
Requires=bmcluster.socket
After=bmcluster.socket
ConditionPathExists=/etc/bmcluster/activated

[Service]
Type=simple
User=bmcluster
Group=bmcluster
EnvironmentFile=/etc/bmcluster/daemon.env
Sockets=bmcluster.socket
ExecStart=/usr/local/bin/bmcluster serve-enrollment
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/bmcluster
CapabilityBoundingSet=
LockPersonality=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
