# Managed by user/init.d/60-caddy — do not edit by hand.
#
# Wildcard cert placeholder for ${SITE_ADDRESSES} via DNS-01/acme-dns.
# Apps register more-specific site blocks and the apex via caddy-route.
#
# Prerequisite: _acme-challenge.<zone> CNAME → the acme-dns account
# fulldomain. One account serves many delegations.

${SITE_ADDRESSES} {
	tls {
		dns acmedns /etc/caddy/acmedns.json
	}
	respond "wildcard zone: ${ZONE_FQDN}" 200
}
