# Central Caddy — global options only. App routes arrive via the Admin API
# (routes.d + caddy-route reconcile); this file must never gain site blocks.
{
	admin unix//run/caddy-admin.sock
	email ${ACME_EMAIL}
	acme_ca https://acme-v02.api.letsencrypt.org/directory
	log {
		# Keep Caddy startup, TLS, certificate, and configuration diagnostics
		# visible through `docker compose logs`.
		output stdout
		format console
		level INFO
	}
$CROWDSEC_SECTION
}
