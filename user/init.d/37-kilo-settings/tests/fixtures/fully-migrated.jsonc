{
  "instructions": ["~/.config/kilo/rules/*.md"],
  "permission": {
    "bash": {
      "*": "allow",
      "sudo": "deny",
      "sudo *": "deny",
      "sudoedit": "deny",
      "sudoedit *": "deny",
      "su": "deny",
      "su *": "deny",
      "runuser": "deny",
      "runuser *": "deny",
      "doas": "deny",
      "doas *": "deny",
      "pkexec": "deny",
      "pkexec *": "deny",
      "rm *": "deny",
      "shred *": "deny",
      "unlink *": "deny",
      "dd *": "deny",
      "mkfs *": "deny",
      "mkfs.* *": "deny",
      "fdisk *": "deny",
      "gdisk *": "deny",
      "parted *": "deny",
      "sfdisk *": "deny",
      "wipefs *": "deny",
      "blkdiscard *": "deny",
      "useradd *": "deny",
      "userdel *": "deny",
      "usermod *": "deny",
      "passwd *": "deny",
      "chpasswd *": "deny",
      "groupadd *": "deny",
      "groupdel *": "deny",
      "groupmod *": "deny",
      "shutdown *": "deny",
      "reboot *": "deny",
      "poweroff *": "deny",
      "halt *": "deny",
      "git clean *": "deny",
      "git reset --hard *": "deny",
      "git push --force *": "deny",
      "git push --force-with-lease *": "deny",
      "git push --delete *": "deny",
      "git branch -D *": "deny",
      "docker system prune *": "deny",
      "docker container prune *": "deny",
      "docker image prune *": "deny",
      "docker volume prune *": "deny",
      "docker network prune *": "deny",
      "docker builder prune *": "deny",
      "docker volume rm *": "deny"
    }
  }
}
