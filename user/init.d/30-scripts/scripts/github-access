#!/usr/bin/env bash
set -euo pipefail

# github-access — interactive GitHub bootstrap access setup.
#
# This script is deliberately interactive. It is installed into ~/scripts by
# the user-tier 30-scripts step and is run by an operator after provisioning.
#
# Credential model:
#   - personal GitHub API/issue/PR access: the operator's gh login
#   - read-only source access: per-repository SSH deploy keys
#   - package registry access: BROADMINDE_PACKAGES_TOKEN (classic PAT)
#   - optional source RW automation: BROADMINDE_SOURCE_RW_TOKEN (classic PAT)
#
# GitHub does not provide a gh/API flow that mints a dedicated fine-grained or
# classic PAT. The script therefore guides token creation, validates the token
# without printing it, stores it in the gitignored bootstrap .env, and leaves
# the non-interactive provisioning steps to consume it.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

log()  { echo -e "\033[1;34m==>\033[0m $*"; }
ok()   { echo -e "\033[1;32m  ✓\033[0m $*"; }
warn() { echo -e "\033[1;33m  ⚠\033[0m $*"; }
fail() { echo -e "\033[1;31m  ✗\033[0m $*" >&2; }

usage() {
  cat <<'EOF'
Usage: github-access [command] [options]

Interactive GitHub access setup for this host.

Commands:
  setup [--ci]       Authenticate gh, configure deploy keys, package auth,
                     and optionally source RW automation credentials
  auth              Authenticate gh only
  deploy-keys       Register/verify the Broadminde read-only deploy keys
  packages [--write] Configure the GitHub Packages token and npm auth
  npm               Alias for packages
  source-rw         Configure the optional source read/write automation PAT
  status            Show the current GitHub/bootstrap access status
  help              Show this help

Environment:
  BOOTSTRAP_ROOT   Bootstrap checkout containing user/init.sh
                   (default: derived from the source checkout, else ~/bootstrap)

Token files:
  BROADMINDE_PACKAGES_TOKEN    Classic PAT for npm/GHCR package access
  BROADMINDE_SOURCE_RW_TOKEN   Optional classic PAT for source pushes/PRs
  GITHUB_PACKAGES_TOKEN        Legacy fallback for BROADMINDE_PACKAGES_TOKEN

Notes:
  - Run as the deploy user, never with sudo.
  - Package tokens need read:packages; add write:packages on publish hosts.
  - Source RW tokens need repo and workflow.
  - gh cannot mint a separate PAT; this helper validates and stores tokens
    created through GitHub's token UI.
EOF
}

require_deploy_user() {
  if [[ $EUID -eq 0 ]]; then
    fail "github-access must run as the deploy user, not root."
    echo "  Run it without sudo from an interactive SSH session." >&2
    exit 1
  fi
}

require_command() {
  local cmd="$1"
  if ! command -v "$cmd" >/dev/null 2>&1; then
    fail "Missing required command: $cmd"
    exit 1
  fi
}

resolve_bootstrap_root() {
  if [[ -n "${BOOTSTRAP_ROOT:-}" ]]; then
    printf '%s\n' "$BOOTSTRAP_ROOT"
    return 0
  fi

  # Source layout: <repo>/user/init.d/30-scripts/scripts/github-access.
  local source_checkout
  if source_checkout="$(cd "$SCRIPT_DIR/../../../.." 2>/dev/null && pwd)"; then
    if [[ -x "$source_checkout/user/init.sh" ]]; then
      printf '%s\n' "$source_checkout"
      return 0
    fi
  fi

  # Deployed layout: ~/scripts/github-access with the checkout at ~/bootstrap.
  printf '%s\n' "$HOME/bootstrap"
}

BOOTSTRAP_ROOT="$(resolve_bootstrap_root)"
USER_INIT="$BOOTSTRAP_ROOT/user/init.sh"
ENV_FILE="$BOOTSTRAP_ROOT/.env"
PACKAGES_TOKEN_VAR="BROADMINDE_PACKAGES_TOKEN"
LEGACY_PACKAGES_TOKEN_VAR="GITHUB_PACKAGES_TOKEN"
SOURCE_RW_TOKEN_VAR="BROADMINDE_SOURCE_RW_TOKEN"

require_bootstrap() {
  if [[ ! -x "$USER_INIT" ]]; then
    fail "Bootstrap user runner not found or not executable: $USER_INIT"
    echo "  Set BOOTSTRAP_ROOT=/path/to/bootstrap and retry." >&2
    exit 1
  fi
}

require_dev_capability() {
  require_bootstrap

  local config_file=""
  if [[ -f "$BOOTSTRAP_ROOT/$(hostname).conf.yml" ]]; then
    config_file="$BOOTSTRAP_ROOT/$(hostname).conf.yml"
  elif [[ -f "$BOOTSTRAP_ROOT/bootstrap.conf.yml" ]]; then
    config_file="$BOOTSTRAP_ROOT/bootstrap.conf.yml"
  fi

  if [[ -z "$config_file" ]]; then
    fail "No bootstrap config found; the dev capability is disabled."
    echo "  Create bootstrap.conf.yml from example.bootstrap.conf.yml and set dev: true." >&2
    exit 1
  fi

  export BOOTSTRAP_CONFIG_FILE="$config_file"
  # shellcheck disable=SC1091
  . "$BOOTSTRAP_ROOT/init.d/lib/conf.sh"
  load_conf "$config_file"

  if ! cap_enabled dev; then
    fail "The dev capability is disabled in $config_file."
    echo "  Set capabilities.dev: true to configure Broadminde private access." >&2
    exit 1
  fi
}

gh_authenticated() {
  gh auth status --hostname github.com >/dev/null 2>&1
}

authenticate_gh() {
  require_command gh

  if gh_authenticated; then
    ok "gh is already authenticated for github.com"
  else
    if [[ ! -t 0 ]]; then
      fail "gh is not authenticated and this script is not attached to a terminal."
      echo "  Run: gh auth login --hostname github.com --git-protocol ssh --web" >&2
      exit 1
    fi

    log "Authenticating gh for github.com"
    gh auth login --hostname github.com --git-protocol ssh --web
  fi

  gh api user --jq '"  authenticated as " + .login + " (" + (.name // "no display name") + ")"'
}

run_user_step() {
  local selector="$1"
  require_bootstrap
  "$USER_INIT" "$selector"
}

configure_deploy_keys() {
  require_dev_capability
  authenticate_gh

  log "Registering and verifying Broadminde read-only deploy keys"
  if ! run_user_step 99-go-shared; then
    fail "Deploy-key setup did not complete."
    echo "  If gh reported a permission error, ask a Broadminde repository admin to" >&2
    echo "  register the public keys printed by user/init.sh 99-go-shared, then run:" >&2
    echo "    $USER_INIT 99-go-shared" >&2
    exit 1
  fi

  ok "Deploy keys registered and verified"
}

file_env_value() {
  local name="$1"
  local value=""

  [[ -f "$ENV_FILE" ]] || return 1
  value="$(sed -n "s/^${name}=//p" "$ENV_FILE" | tail -n 1)"
  [[ -n "$value" ]] || return 1
  printf '%s\n' "$value"
}

current_env_value() {
  local name="$1"
  local value=""

  if value="$(printenv "$name" 2>/dev/null)" && [[ -n "$value" ]]; then
    printf '%s\n' "$value"
    return 0
  fi

  file_env_value "$name"
}

env_file_has_value() {
  local name="$1"
  file_env_value "$name" >/dev/null
}

write_env_value() {
  local name="$1"
  local value="$2"
  local tmp

  mkdir -p "$BOOTSTRAP_ROOT"
  touch "$ENV_FILE"
  chmod 600 "$ENV_FILE"

  tmp="$(mktemp "$BOOTSTRAP_ROOT/.env.XXXXXX")"
  trap 'rm -f "$tmp"' RETURN

  grep -vE "^${name}=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$name" "$value" >> "$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$ENV_FILE"
  trap - RETURN
}

ensure_env_file_private() {
  if [[ -f "$ENV_FILE" && "$(stat -c %a "$ENV_FILE")" != "600" ]]; then
    chmod 600 "$ENV_FILE"
    ok "Tightened $ENV_FILE permissions to 0600"
  fi
}

packages_token_url() {
  local mode="$1"
  local scopes="read:packages"

  if [[ "$mode" == "write" ]]; then
    scopes="read:packages,write:packages"
  fi

  printf 'https://github.com/settings/tokens/new?scopes=%s&description=%s\n' \
    "$scopes" "$(hostname)-packages-${mode}"
}

source_rw_token_url() {
  printf 'https://github.com/settings/tokens/new?scopes=repo,workflow&description=%s\n' \
    "$(hostname)-source-rw"
}

token_scopes() {
  local token="$1"

  GH_TOKEN="$token" gh api user --include 2>/dev/null \
    | awk 'BEGIN{IGNORECASE=1} /^x-oauth-scopes:/ {
        sub(/^[^:]*:[[:space:]]*/, "")
        gsub(/\r/, "")
        print
        exit
      }'
}

token_has_scope() {
  local scopes="$1"
  local required="$2"
  local normalized

  normalized=",$(printf '%s' "$scopes" | tr -d '[:space:]'),"
  [[ "$normalized" == *",$required,"* ]]
}

validate_package_token() {
  local token="$1"
  local mode="$2"
  local scopes=""

  if ! scopes="$(token_scopes "$token")" || [[ -z "$scopes" ]]; then
    fail "Could not verify the package token scopes."
    echo "  Use a classic PAT; fine-grained PATs are not supported by the npm registry." >&2
    return 1
  fi

  if [[ "$mode" == "write" ]]; then
    if ! token_has_scope "$scopes" "write:packages"; then
      fail "The package token is missing write:packages."
      return 1
    fi
  elif ! token_has_scope "$scopes" "read:packages" && ! token_has_scope "$scopes" "write:packages"; then
    fail "The package token is missing read:packages."
    return 1
  fi

  ok "Package token scopes verified"
}

validate_source_rw_token() {
  local token="$1"
  local scopes=""
  local missing=()
  local repo push_allowed

  if ! scopes="$(token_scopes "$token")" || [[ -z "$scopes" ]]; then
    fail "Could not verify the source RW token scopes."
    echo "  Use a classic PAT with repo and workflow scopes." >&2
    return 1
  fi

  token_has_scope "$scopes" "repo" || missing+=("repo")
  token_has_scope "$scopes" "workflow" || missing+=("workflow")

  if [[ ${#missing[@]} -gt 0 ]]; then
    fail "The source RW token is missing required scopes: ${missing[*]}"
    return 1
  fi

  for repo in "broadminde-org/go-shared" "broadminde-org/frontend-shared"; do
    if ! push_allowed="$(GH_TOKEN="$token" gh api "repos/$repo" --jq '.permissions.push // false' 2>/dev/null)"; then
      fail "The source RW token cannot read $repo."
      return 1
    fi
    if [[ "$push_allowed" != "true" ]]; then
      fail "The token identity does not have push permission on $repo."
      return 1
    fi
  done

  ok "Source RW token scopes and repository push access verified"
}

print_package_token_guidance() {
  local mode="$1"
  local required_scopes="read:packages"

  if [[ "$mode" == "write" ]]; then
    required_scopes="read:packages, write:packages"
  fi

  cat <<EOF

GitHub Packages npm/GHCR auth uses a dedicated classic PAT. Fine-grained PATs
are not supported by the npm registry, and gh's own OAuth token is not copied
into package credentials.

Create the token here:
  $(packages_token_url "$mode")

Required scopes: $required_scopes
If broadminde-org enforces SSO, authorize the token for the organization after
creating it.

The token is stored in:
  $ENV_FILE
and then written by user/init.d/98-npm-shared to ~/.npmrc with mode 0600.
EOF
}

print_source_rw_token_guidance() {
  cat <<EOF

Source RW automation uses a separate classic PAT for pushes, issues, and pull
requests. Keep it separate from package auth so the broad repository token is
never written to ~/.npmrc.

Create the token here:
  $(source_rw_token_url)

Required scopes: repo, workflow
The workflow scope is required if automation can push changes under
.github/workflows/. If broadminde-org enforces SSO, authorize the token for
the organization after creating it.
EOF
}

prompt_for_token() {
  local prompt="$1"

  PROMPTED_TOKEN=""
  if [[ ! -t 0 ]]; then
    fail "No interactive terminal is available for token input."
    return 1
  fi

  read -rsp "$prompt" PROMPTED_TOKEN
  echo ""
  [[ -n "$PROMPTED_TOKEN" ]]
}

confirm_store_token() {
  local name="$1"
  local reply=""

  if env_file_has_value "$name"; then
    read -rp "Replace the stored $name in $ENV_FILE? [y/N] " reply
    [[ "$reply" =~ ^([yY]|[yY][eE][sS])$ ]]
  else
    read -rp "Store $name in $ENV_FILE for future bootstrap/CI runs? [Y/n] " reply
    reply="${reply:-y}"
    [[ "$reply" =~ ^([yY]|[yY][eE][sS])$ ]]
  fi
}

configure_packages() {
  local mode="read"
  local current=""
  local token=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --write|--packages-write)
        mode="write"
        ;;
      *)
        fail "Unknown packages option: $1"
        usage >&2
        exit 2
        ;;
    esac
    shift
  done

  require_dev_capability
  ensure_env_file_private

  if ! current="$(current_env_value "$PACKAGES_TOKEN_VAR")"; then
    current="$(current_env_value "$LEGACY_PACKAGES_TOKEN_VAR" || true)"
  fi

  if [[ -n "$current" ]]; then
    log "Checking the stored GitHub Packages token"
    if validate_package_token "$current" "$mode" && run_user_step 98-npm-shared; then
      ok "GitHub Packages auth configured"
      return 0
    fi
    warn "The stored package token is missing the requested scopes or failed verification."
  fi

  print_package_token_guidance "$mode"

  if ! prompt_for_token "Paste the GitHub Packages token (input hidden, Enter to skip): "; then
    warn "Package auth skipped; rerun github-access packages after creating the token."
    return 0
  fi
  token="$PROMPTED_TOKEN"

  if ! validate_package_token "$token" "$mode"; then
    exit 1
  fi

  if confirm_store_token "$PACKAGES_TOKEN_VAR"; then
    write_env_value "$PACKAGES_TOKEN_VAR" "$token"
    run_user_step 98-npm-shared
  else
    if env_file_has_value "$PACKAGES_TOKEN_VAR" || env_file_has_value "$LEGACY_PACKAGES_TOKEN_VAR"; then
      fail "A stored package token exists; replace it or fix $ENV_FILE."
      exit 1
    fi
    BROADMINDE_PACKAGES_TOKEN="$token" run_user_step 98-npm-shared
  fi

  ok "GitHub Packages auth configured"
}

configure_source_rw() {
  local current=""
  local token=""

  require_command gh
  ensure_env_file_private

  current="$(current_env_value "$SOURCE_RW_TOKEN_VAR" || true)"
  if [[ -n "$current" ]]; then
    log "Checking the stored source RW token"
    if validate_source_rw_token "$current"; then
      ok "Source RW token is already configured"
      return 0
    fi
    warn "The stored source RW token failed validation."
  fi

  print_source_rw_token_guidance

  if ! prompt_for_token "Paste the source RW token (input hidden, Enter to skip): "; then
    fail "Source RW setup skipped."
    return 1
  fi
  token="$PROMPTED_TOKEN"

  if ! validate_source_rw_token "$token"; then
    exit 1
  fi

  if ! confirm_store_token "$SOURCE_RW_TOKEN_VAR"; then
    fail "The source RW token was not stored; source RW access is not configured."
    echo "  Rerun github-access source-rw and store the token to make it available to CI." >&2
    exit 1
  fi

  write_env_value "$SOURCE_RW_TOKEN_VAR" "$token"
  ok "Source RW token stored in $ENV_FILE"
  echo "  Pass it to CI jobs as GH_TOKEN or BROADMINDE_SOURCE_RW_TOKEN; do not commit it."
}

status_token() {
  local label="$1"
  local name="$2"

  if current_env_value "$name" >/dev/null; then
    echo "  present: $label ($name)"
  else
    echo "  missing: $label ($name)"
  fi
}

show_status() {
  require_command gh

  log "gh authentication"
  if gh_authenticated; then
    gh api user --jq '"  authenticated as " + .login'
  else
    warn "gh is not authenticated for github.com"
  fi

  echo ""
  log "Bootstrap checkout"
  echo "  root: $BOOTSTRAP_ROOT"
  if [[ -x "$USER_INIT" ]]; then
    echo "  user runner: $USER_INIT"
  else
    warn "user runner not found: $USER_INIT"
  fi

  echo ""
  log "Bootstrap token file"
  if [[ -f "$ENV_FILE" ]]; then
    printf '  present: %s (mode %s)\n' "$ENV_FILE" "$(stat -c %a "$ENV_FILE")"
    if [[ "$(stat -c %a "$ENV_FILE")" != "600" ]]; then
      warn "$ENV_FILE should be mode 600; run a token setup command to fix it."
    fi
  else
    echo "  missing: $ENV_FILE"
  fi
  status_token "GitHub Packages" "$PACKAGES_TOKEN_VAR"
  status_token "legacy GitHub Packages" "$LEGACY_PACKAGES_TOKEN_VAR"
  status_token "source RW" "$SOURCE_RW_TOKEN_VAR"

  echo ""
  log "Local credential files"
  local path
  for path in \
    "$HOME/.ssh/go-shared-read" \
    "$HOME/.ssh/frontend-shared-read" \
    "$HOME/.npmrc"; do
    if [[ -f "$path" ]]; then
      printf '  present: %s (mode %s)\n' "$path" "$(stat -c %a "$path")"
    else
      printf '  missing: %s\n' "$path"
    fi
  done
}

reject_extra_args() {
  if [[ $# -gt 0 ]]; then
    usage >&2
    exit 2
  fi
}

main() {
  require_deploy_user

  local command="${1:-setup}"
  if [[ $# -gt 0 ]]; then
    shift
  fi

  case "$command" in
    setup)
      local ci=false
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --ci)
            ci=true
            ;;
          *)
            fail "Unknown setup option: $1"
            usage >&2
            exit 2
            ;;
        esac
        shift
      done

      configure_deploy_keys
      if [[ "$ci" == "true" ]]; then
        configure_packages --write
        configure_source_rw
      else
        configure_packages
      fi
      ;;
    auth)
      reject_extra_args "$@"
      authenticate_gh
      ;;
    deploy-keys)
      reject_extra_args "$@"
      configure_deploy_keys
      ;;
    packages|npm)
      configure_packages "$@"
      ;;
    source-rw)
      reject_extra_args "$@"
      configure_source_rw
      ;;
    status)
      reject_extra_args "$@"
      show_status
      ;;
    help|--help|-h)
      reject_extra_args "$@"
      usage
      ;;
    *)
      fail "Unknown command: $command"
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
