#!/usr/bin/env bash
set -euo pipefail

# github-access — interactive GitHub bootstrap access setup.
#
# This script is deliberately interactive. It is installed into ~/scripts by
# the user-tier 30-scripts step and is run by an operator after provisioning.
#
# Credential model:
#   - personal GitHub API/issue/PR access: the operator's gh login
#   - read-only source access: per-repository SSH deploy keys
#   - package registry access: BROADMINDE_PACKAGES_TOKEN (classic PAT)
#   - optional source RW automation: BROADMINDE_SOURCE_RW_TOKEN (classic PAT)
#
# Storage model (docs/adr/0001-github-pat-storage.md):
#   - Both classic PATs live in dedicated token files under ~/.config/gh/
#     (mode 0600) — never in the bootstrap checkout .env.
#   - A legacy .env entry found on run is migrated: copied to the token file
#     after validation, then removed from .env.
#
# GitHub does not provide a gh/API flow that mints a dedicated fine-grained or
# classic PAT. The script therefore guides token creation, validates the token
# without printing it, stores it in the ~/.config/gh/ token file, and leaves
# the non-interactive provisioning steps to consume it.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Shared helpers: log/ok/warn/fail, require_deploy_user,
# resolve_bootstrap_root, file_env_value/write_env_value. Ships next to this
# script as lib/access-common.sh (deployed by the 30-scripts step).
# shellcheck disable=SC1091
. "$SCRIPT_DIR/lib/access-common.sh"

usage() {
  cat <<'EOF'
Usage: github-access [command] [options]

Interactive GitHub access setup for this host.

Commands:
  setup [--ci]       Authenticate gh, configure deploy keys, package auth,
                     and optionally source RW automation credentials
  auth              Authenticate gh only
  deploy-keys       Register/verify the Broadminde read-only deploy keys
  packages [--write] Configure the GitHub Packages token and npm auth
  npm               Alias for packages
  source-rw         Configure the optional source read/write automation PAT
  clear packages    Remove the packages token (file, legacy .env, ~/.npmrc)
  clear source-rw   Remove the source RW token (file and legacy .env)
  clear --all       Remove both tokens
  status            Show the current GitHub/bootstrap access status
  help              Show this help

Environment:
  BOOTSTRAP_ROOT   Bootstrap checkout containing user/init.sh
                   (default: derived from the source checkout, else ~/bootstrap)

Token files (mode 0600; the bootstrap .env is never a token store):
  ~/.config/gh/broadminde-packages.token   Classic PAT for npm/GHCR package access
  ~/.config/gh/broadminde-source-rw.token  Optional classic PAT for source pushes/PRs

Notes:
  - Run as the deploy user, never with sudo.
  - Package tokens need read:packages; add write:packages on publish hosts.
  - Source RW tokens need repo and workflow.
  - gh cannot mint a separate PAT; this helper validates and stores tokens
    created through GitHub's token UI.
EOF
}

require_command() {
  local cmd="$1"
  if ! command -v "$cmd" >/dev/null 2>&1; then
    fail "Missing required command: $cmd"
    exit 1
  fi
}

BOOTSTRAP_ROOT="$(resolve_bootstrap_root)"
USER_INIT="$BOOTSTRAP_ROOT/user/init.sh"
ENV_FILE="$BOOTSTRAP_ROOT/.env"
PACKAGES_TOKEN_VAR="BROADMINDE_PACKAGES_TOKEN"
SOURCE_RW_TOKEN_VAR="BROADMINDE_SOURCE_RW_TOKEN"

# Authoritative PAT storage: dedicated files next to gh's own credential
# store. gh only ever manages hosts.yml/config.yml here and never touches
# foreign files. See docs/adr/0001-github-pat-storage.md.
GH_CONFIG_DIR="$HOME/.config/gh"
PACKAGES_TOKEN_FILE="$GH_CONFIG_DIR/broadminde-packages.token"
SOURCE_RW_TOKEN_FILE="$GH_CONFIG_DIR/broadminde-source-rw.token"

# Retired pre-rename name — no longer read as a source, but still detected
# and removed by clear/status so a host predating the rename is cleaned up.
LEGACY_PACKAGES_TOKEN_VAR="GITHUB_PACKAGES_TOKEN"

# Set by current_token_value to env|file|legacy|none so callers know where
# the resolved value came from (an env value is never persisted).
CURRENT_TOKEN_SOURCE=""

require_bootstrap() {
  if [[ ! -x "$USER_INIT" ]]; then
    fail "Bootstrap user runner not found or not executable: $USER_INIT"
    echo "  Set BOOTSTRAP_ROOT=/path/to/bootstrap and retry." >&2
    exit 1
  fi
}

require_dev_capability() {
  require_bootstrap

  local conf_sh="$BOOTSTRAP_ROOT/init.d/lib/conf.sh"
  if [[ ! -f "$conf_sh" ]]; then
    fail "Bootstrap conf library not found: $conf_sh"
    exit 1
  fi
  # shellcheck disable=SC1090
  . "$conf_sh"

  local config_file=""
  if ! config_file="$(resolve_conf_file)"; then
    fail "No bootstrap config found; the dev capability is disabled."
    echo "  Create bootstrap.conf.yml from example.bootstrap.conf.yml and set dev: true." >&2
    exit 1
  fi

  export BOOTSTRAP_CONFIG_FILE="$config_file"
  load_conf "$config_file"

  if ! cap_enabled dev; then
    fail "The dev capability is disabled in $config_file."
    echo "  Set capabilities.dev: true to configure Broadminde private access." >&2
    exit 1
  fi
}

gh_authenticated() {
  gh auth status --hostname github.com >/dev/null 2>&1
}

authenticate_gh() {
  require_command gh

  if gh_authenticated; then
    ok "gh is already authenticated for github.com"
  else
    if [[ ! -t 0 ]]; then
      fail "gh is not authenticated and this script is not attached to a terminal."
      echo "  Run: gh auth login --hostname github.com --git-protocol ssh --web" >&2
      exit 1
    fi

    log "Authenticating gh for github.com"
    gh auth login --hostname github.com --git-protocol ssh --web
  fi

  gh api user --jq '"  authenticated as " + .login + " (" + (.name // "no display name") + ")"'
}

run_user_step() {
  local selector="$1"
  require_bootstrap
  "$USER_INIT" "$selector"
}

configure_deploy_keys() {
  require_dev_capability
  authenticate_gh

  log "Registering and verifying Broadminde read-only deploy keys"
  if ! run_user_step 99-go-shared; then
    fail "Deploy-key setup did not complete."
    echo "  If gh reported a permission error, ask a Broadminde repository admin to" >&2
    echo "  register the public keys printed by user/init.sh 99-go-shared, then run:" >&2
    echo "    $USER_INIT 99-go-shared" >&2
    exit 1
  fi

  ok "Deploy keys registered and verified"
}

# current_token_value <env-var> <token-file> — resolve the current token:
# environment first (transient/CI use), then the authoritative token file,
# then the legacy bootstrap .env entry (migration source only). Sets
# CURRENT_TOKEN_SOURCE to env|file|legacy|none so callers can tell where the
# value came from.
current_token_value() {
  local name="$1" file="$2" value=""

  CURRENT_TOKEN_SOURCE="none"

  if value="$(printenv "$name" 2>/dev/null)" && [[ -n "$value" ]]; then
    CURRENT_TOKEN_SOURCE="env"
    printf '%s\n' "$value"
    return 0
  fi

  if value="$(read_token_file "$file")"; then
    CURRENT_TOKEN_SOURCE="file"
    printf '%s\n' "$value"
    return 0
  fi

  if value="$(file_env_value "$ENV_FILE" "$name")"; then
    CURRENT_TOKEN_SOURCE="legacy"
    printf '%s\n' "$value"
    return 0
  fi
  return 1
}

# migrate_legacy_env_token <env-var> <token-file> — remove the legacy
# bootstrap .env entry once the token file holds the credential.
migrate_legacy_env_token() {
  local name="$1" file="$2"

  if ! read_token_file "$file" >/dev/null; then
    return 0
  fi
  if file_env_value "$ENV_FILE" "$name" >/dev/null; then
    delete_env_value "$ENV_FILE" "$name"
    ok "Removed legacy $name entry from $ENV_FILE (now stored in $file)"
  fi
}

packages_token_url() {
  local mode="$1"
  local scopes="read:packages"

  if [[ "$mode" == "write" ]]; then
    scopes="read:packages,write:packages"
  fi

  printf 'https://github.com/settings/tokens/new?scopes=%s&description=%s\n' \
    "$scopes" "$(hostname)-packages-${mode}"
}

source_rw_token_url() {
  printf 'https://github.com/settings/tokens/new?scopes=repo,workflow&description=%s\n' \
    "$(hostname)-source-rw"
}

# token_scopes <token> — print the token's X-OAuth-Scopes header value.
# Returns 1 when the token is rejected (gh api exits non-zero on 401 once
# stdout is captured) or when the response carries no scopes header (which
# is the case for fine-grained PATs and OAuth-app tokens — both unsupported
# by the npm registry).
#
# gh prints response headers in canonical case (X-Oauth-Scopes:), and the
# Debian/Ubuntu awk is mawk, which does not implement gawk's IGNORECASE —
# so match via tolower(), which every awk supports.
token_scopes() {
  local token="$1"
  local response=""

  if ! response="$(GH_TOKEN="$token" gh api user --include 2>/dev/null)"; then
    return 1
  fi

  printf '%s\n' "$response" \
    | awk '{
        gsub(/\r/, "")
        if (tolower($0) ~ /^x-oauth-scopes:/) {
          sub(/^[^:]*:[[:space:]]*/, "")
          print
          exit
        }
      }'
}

token_has_scope() {
  local scopes="$1"
  local required="$2"
  local normalized

  normalized=",$(printf '%s' "$scopes" | tr -d '[:space:]'),"
  [[ "$normalized" == *",$required,"* ]]
}

validate_package_token() {
  local token="$1"
  local mode="$2"
  local scopes=""

  if ! scopes="$(token_scopes "$token")"; then
    fail "GitHub rejected the package token (or it is not a classic PAT)."
    echo "  Use a classic PAT; fine-grained PATs are not supported by the npm registry." >&2
    return 1
  fi
  if [[ -z "$scopes" ]]; then
    fail "The token carries no OAuth scopes (fine-grained PAT or OAuth token?)."
    echo "  Create a CLASSIC PAT with the prefilled URL above." >&2
    return 1
  fi

  # Read capability is mandatory in both modes: 98-npm-shared verifies auth
  # by pulling from the registry. write:packages implies read access — GitHub
  # does not list implied scopes in X-Oauth-Scopes (same as repo implying
  # repo:status), so a write-only token reports "write:packages" without
  # "read:packages" yet pulls fine. Accept either scope.
  if ! token_has_scope "$scopes" "read:packages" && ! token_has_scope "$scopes" "write:packages"; then
    fail "The package token has neither read:packages nor write:packages."
    echo "  Token currently has: $scopes" >&2
    return 1
  fi
  if [[ "$mode" == "write" ]] && ! token_has_scope "$scopes" "write:packages"; then
    fail "The package token is missing write:packages."
    echo "  Token currently has: $scopes" >&2
    return 1
  fi

  ok "Package token scopes verified ($scopes)"
}

SOURCE_RW_REPOS=("broadminde-org/go-shared" "broadminde-org/frontend-shared")

# check_source_rw_identity — verify the gh CLI identity itself has push
# permission on the source repos. Called before prompting for the PAT so the
# operator learns about a wrong-account problem before minting the token.
# Warns (does not abort) on missing access: the PAT may belong to a different,
# more privileged account — the post-paste validation makes the final call.
# Aborts only when gh is not authenticated at all, since nothing else works.
check_source_rw_identity() {
  if ! gh_authenticated; then
    fail "gh is not authenticated for github.com."
    echo "  Run: github-access auth" >&2
    exit 1
  fi

  local login push_allowed repo
  login="$(gh api user --jq .login)"

  for repo in "${SOURCE_RW_REPOS[@]}"; do
    if ! push_allowed="$(gh api "repos/$repo" --jq '.permissions.push // false' 2>/dev/null)"; then
      fail "The gh identity ($login) cannot read $repo."
      echo "  The token account needs push on it. Continuing anyway — paste a" >&2
      echo "  token for an account with access, or Enter to skip." >&2
      return 1
    fi
    if [[ "$push_allowed" != "true" ]]; then
      fail "The gh identity ($login) does not have push permission on $repo."
      echo "  The token account needs push on it. Continuing anyway — paste a" >&2
      echo "  token for an account with access, or Enter to skip." >&2
      return 1
    fi
  done

  ok "gh identity ($login) has push on the broadminde-org source repos"
}

validate_source_rw_token() {
  local token="$1"
  local scopes=""
  local missing=()
  local repo push_allowed

  if ! scopes="$(token_scopes "$token")" || [[ -z "$scopes" ]]; then
    fail "Could not verify the source RW token scopes."
    echo "  Use a classic PAT with repo and workflow scopes." >&2
    return 1
  fi

  token_has_scope "$scopes" "repo" || missing+=("repo")
  token_has_scope "$scopes" "workflow" || missing+=("workflow")

  if [[ ${#missing[@]} -gt 0 ]]; then
    fail "The source RW token is missing required scopes: ${missing[*]}"
    return 1
  fi

  for repo in "${SOURCE_RW_REPOS[@]}"; do
    if ! push_allowed="$(GH_TOKEN="$token" gh api "repos/$repo" --jq '.permissions.push // false' 2>/dev/null)"; then
      fail "The source RW token cannot read $repo."
      return 1
    fi
    if [[ "$push_allowed" != "true" ]]; then
      fail "The token identity does not have push permission on $repo."
      return 1
    fi
  done

  ok "Source RW token scopes and repository push access verified"
}

print_package_token_guidance() {
  local mode="$1"
  local required_scopes="read:packages"

  if [[ "$mode" == "write" ]]; then
    required_scopes="read:packages, write:packages"
  fi

  cat <<EOF

GitHub Packages npm/GHCR auth uses a dedicated classic PAT. Fine-grained PATs
are not supported by the npm registry, and gh's own OAuth token is not copied
into package credentials.

Create a CLASSIC token here (the URL pre-selects the scopes):
  $(packages_token_url "$mode")

Required permissions (classic PAT scopes):
  - read:packages      pull @broadminde-org/* npm packages and GHCR images
  - write:packages     publish packages — publish/CI hosts only
This host needs: $required_scopes
If broadminde-org enforces SSO, click "Configure SSO" → authorize the
organization on the token page after creating it, or pulls return 404/401.

The token is stored in:
  $PACKAGES_TOKEN_FILE
(mode 0600, outside the bootstrap checkout) and then written by
user/init.d/98-npm-shared to ~/.npmrc with mode 0600.
EOF
}

print_source_rw_token_guidance() {
  cat <<EOF

Source RW automation uses a separate classic PAT for pushes, issues, and pull
requests. Keep it separate from package auth so the broad repository token is
never written to ~/.npmrc.

Create a CLASSIC token here (the URL pre-selects the scopes):
  $(source_rw_token_url)

Required permissions (classic PAT scopes — the URL pre-selects both):
  - repo        full read/write on the private broadminde-org repos
                (clone, push, issues, pull requests)
  - workflow    required whenever a push touches .github/workflows/ —
                without it such pushes are rejected
Push access on the source repos is verified above (and re-checked against the
token after paste). If broadminde-org enforces SSO, authorize the token for
the organization after creating it, or pushes return 404/401.

The token is stored in:
  $SOURCE_RW_TOKEN_FILE
(mode 0600, outside the bootstrap checkout). To seed CI, paste it into the
CI secret store (e.g. a Woodpecker repo secret) — do not commit it anywhere.
EOF
}

# prompt_for_token <prompt> — hidden read into PROMPTED_TOKEN.
# A fast paste can land after read(1) has already consumed the line in a
# no-echo field, yielding an empty string — re-prompt on empty input instead
# of flowing an empty token into validation. A second empty Enter is treated
# as an intentional skip (returns 1) so callers keep their skip semantics.
prompt_for_token() {
  local prompt="$1"
  local reprompt="${2:-Paste again, or Enter to skip: }"

  PROMPTED_TOKEN=""
  if [[ ! -t 0 ]]; then
    fail "No interactive terminal is available for token input."
    return 1
  fi

  read -rsp "$prompt" PROMPTED_TOKEN
  echo ""
  if [[ -z "$PROMPTED_TOKEN" ]]; then
    warn "No token received (the paste may not have landed in the hidden field)."
    read -rsp "$reprompt" PROMPTED_TOKEN
    echo ""
  fi
  [[ -n "$PROMPTED_TOKEN" ]]
}

configure_packages() {
  local mode="read"
  local current=""
  local token=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --write|--packages-write)
        mode="write"
        ;;
      *)
        fail "Unknown packages option: $1"
        usage >&2
        exit 2
        ;;
    esac
    shift
  done

  require_dev_capability

  if ! current="$(current_token_value "$PACKAGES_TOKEN_VAR" "$PACKAGES_TOKEN_FILE")"; then
    current=""
  fi

  if [[ -n "$current" ]]; then
    log "Checking the stored GitHub Packages token"
    if validate_package_token "$current" "$mode"; then
      # Persist to the authoritative token file only from the legacy .env
      # migration path. An environment value is a transient override and is
      # never written to the file.
      if [[ "$CURRENT_TOKEN_SOURCE" == "legacy" ]]; then
        write_token_file "$PACKAGES_TOKEN_FILE" "$current"
        ok "Stored $PACKAGES_TOKEN_VAR in $PACKAGES_TOKEN_FILE"
      fi
      migrate_legacy_env_token "$PACKAGES_TOKEN_VAR" "$PACKAGES_TOKEN_FILE"
      run_user_step 98-npm-shared
      ok "GitHub Packages auth configured"
      return 0
    fi
    warn "The stored package token is missing the requested scopes or failed verification."
  fi

  print_package_token_guidance "$mode"

  if ! prompt_for_token "Paste the GitHub Packages token (input hidden, Enter to skip): "; then
    warn "Package auth skipped; rerun github-access packages after creating the token."
    return 0
  fi
  token="$PROMPTED_TOKEN"

  if ! validate_package_token "$token" "$mode"; then
    exit 1
  fi

  # Storage is the whole point — the validated token replaces any stale one.
  write_token_file "$PACKAGES_TOKEN_FILE" "$token"
  ok "Stored $PACKAGES_TOKEN_VAR in $PACKAGES_TOKEN_FILE"
  migrate_legacy_env_token "$PACKAGES_TOKEN_VAR" "$PACKAGES_TOKEN_FILE"
  run_user_step 98-npm-shared

  ok "GitHub Packages auth configured"
}

configure_source_rw() {
  local current=""
  local token=""

  require_command gh

  current="$(current_token_value "$SOURCE_RW_TOKEN_VAR" "$SOURCE_RW_TOKEN_FILE" || true)"
  if [[ -n "$current" ]]; then
    log "Checking the stored source RW token"
    if validate_source_rw_token "$current"; then
      # Persist to the authoritative token file only from the legacy .env
      # migration path. An environment value is a transient override and is
      # never written to the file.
      if [[ "$CURRENT_TOKEN_SOURCE" == "legacy" ]]; then
        write_token_file "$SOURCE_RW_TOKEN_FILE" "$current"
        ok "Stored $SOURCE_RW_TOKEN_VAR in $SOURCE_RW_TOKEN_FILE"
      fi
      migrate_legacy_env_token "$SOURCE_RW_TOKEN_VAR" "$SOURCE_RW_TOKEN_FILE"
      ok "Source RW token is already configured"
      return 0
    fi
    warn "The stored source RW token failed validation."
  fi

  # The identity check only warns on a wrong/lower-privilege account; its
  # non-zero return must not abort under set -e (the post-paste validation
  # makes the final call).
  check_source_rw_identity || true
  print_source_rw_token_guidance

  if ! prompt_for_token "Paste the source RW token (input hidden, Enter to skip): "; then
    fail "Source RW setup skipped."
    return 1
  fi
  token="$PROMPTED_TOKEN"

  if ! validate_source_rw_token "$token"; then
    exit 1
  fi

  write_token_file "$SOURCE_RW_TOKEN_FILE" "$token"
  ok "Source RW token stored in $SOURCE_RW_TOKEN_FILE"
  migrate_legacy_env_token "$SOURCE_RW_TOKEN_VAR" "$SOURCE_RW_TOKEN_FILE"
  echo "  Pass it to CI jobs as GH_TOKEN or BROADMINDE_SOURCE_RW_TOKEN; do not commit it."
}

status_token() {
  local label="$1"
  local name="$2"
  local file="$3"

  if read_token_file "$file" >/dev/null; then
    echo "  present: $label ($file)"
  elif printenv "$name" >/dev/null 2>&1; then
    echo "  present: $label ($name environment variable only, not stored)"
  else
    echo "  missing: $label ($file)"
  fi

  # Warn about a lingering legacy .env entry even when the token file (or an
  # environment override) already supplies the credential.
  if file_env_value "$ENV_FILE" "$name" >/dev/null; then
    warn "  legacy: $label still in $ENV_FILE — rerun 'github-access' to migrate"
  fi
}

show_status() {
  require_command gh

  log "gh authentication"
  if gh_authenticated; then
    gh api user --jq '"  authenticated as " + .login'
  else
    warn "gh is not authenticated for github.com"
  fi

  echo ""
  log "Bootstrap checkout"
  echo "  root: $BOOTSTRAP_ROOT"
  if [[ -x "$USER_INIT" ]]; then
    echo "  user runner: $USER_INIT"
  else
    warn "user runner not found: $USER_INIT"
  fi

  echo ""
  log "GitHub PAT storage"
  status_token "GitHub Packages" "$PACKAGES_TOKEN_VAR" "$PACKAGES_TOKEN_FILE"
  status_token "source RW" "$SOURCE_RW_TOKEN_VAR" "$SOURCE_RW_TOKEN_FILE"
  if file_env_value "$ENV_FILE" "$LEGACY_PACKAGES_TOKEN_VAR" >/dev/null; then
    warn "  legacy: retired $LEGACY_PACKAGES_TOKEN_VAR still in $ENV_FILE — run 'github-access clear packages' to remove it"
  fi

  echo ""
  log "Local credential files"
  local path
  for path in \
    "$HOME/.ssh/go-shared-read" \
    "$HOME/.ssh/frontend-shared-read" \
    "$HOME/.npmrc"; do
    if [[ -f "$path" ]]; then
      printf '  present: %s (mode %s)\n' "$path" "$(stat -c %a "$path")"
    else
      printf '  missing: %s\n' "$path"
    fi
  done
}

# ---------------------------------------------------------------------------
# clear — remove stored credentials. No confirmation prompts: the token can
# be re-stored at any time with `github-access packages` / `source-rw`.
# Deliberately does NOT require the bootstrap checkout or gh: it only touches
# files under $HOME (plus the legacy .env when present).
# ---------------------------------------------------------------------------

clear_packages() {
  local removed=false

  if [[ -e "$PACKAGES_TOKEN_FILE" ]]; then
    delete_token_file "$PACKAGES_TOKEN_FILE"
    ok "Removed $PACKAGES_TOKEN_FILE"
    removed=true
  fi
  if file_env_value "$ENV_FILE" "$PACKAGES_TOKEN_VAR" >/dev/null; then
    delete_env_value "$ENV_FILE" "$PACKAGES_TOKEN_VAR"
    ok "Removed $PACKAGES_TOKEN_VAR from $ENV_FILE"
    removed=true
  fi
  if file_env_value "$ENV_FILE" "$LEGACY_PACKAGES_TOKEN_VAR" >/dev/null; then
    delete_env_value "$ENV_FILE" "$LEGACY_PACKAGES_TOKEN_VAR"
    ok "Removed retired $LEGACY_PACKAGES_TOKEN_VAR from $ENV_FILE"
    removed=true
  fi

  # 98-npm-shared writes exactly two managed lines to ~/.npmrc, preserving
  # any other user config. Remove only those lines; drop the file when
  # nothing else remains.
  local npmrc="$HOME/.npmrc"
  local registry_key='@broadminde-org:registry='
  local auth_key='//npm.pkg.github.com/:_authToken='
  if [[ -f "$npmrc" ]] && { grep -qF "$registry_key" "$npmrc" || grep -qF "$auth_key" "$npmrc"; }; then
    local tmp
    tmp="$(mktemp "$HOME/.npmrc.XXXXXX")"
    grep -vF -e "$registry_key" -e "$auth_key" "$npmrc" > "$tmp" || true
    if [[ -s "$tmp" ]]; then
      chmod 600 "$tmp"
      mv -f "$tmp" "$npmrc"
      ok "Removed the GitHub Packages lines from $npmrc (other entries kept)"
    else
      rm -f "$tmp" "$npmrc"
      ok "Removed $npmrc (it contained only the GitHub Packages auth)"
    fi
    removed=true
  fi

  if [[ "$removed" == false ]]; then
    ok "No packages credentials stored; nothing to clear"
    return 0
  fi
  warn "user/init.sh 98-npm-shared will skip npm auth until a new token is stored (github-access packages)."
}

clear_source_rw() {
  local removed=false

  if [[ -e "$SOURCE_RW_TOKEN_FILE" ]]; then
    delete_token_file "$SOURCE_RW_TOKEN_FILE"
    ok "Removed $SOURCE_RW_TOKEN_FILE"
    removed=true
  fi
  if file_env_value "$ENV_FILE" "$SOURCE_RW_TOKEN_VAR" >/dev/null; then
    delete_env_value "$ENV_FILE" "$SOURCE_RW_TOKEN_VAR"
    ok "Removed $SOURCE_RW_TOKEN_VAR from $ENV_FILE"
    removed=true
  fi

  if [[ "$removed" == false ]]; then
    ok "No source RW credential stored; nothing to clear"
    return 0
  fi
  warn "CI/automation must receive a new token (github-access source-rw) before source pushes resume."
}

clear_credentials() {
  local target="${1:-}"

  case "$target" in
    packages|npm)
      shift
      reject_extra_args "$@"
      clear_packages
      ;;
    source-rw)
      shift
      reject_extra_args "$@"
      clear_source_rw
      ;;
    --all|all)
      shift
      reject_extra_args "$@"
      clear_packages
      echo ""
      clear_source_rw
      ;;
    "")
      fail "Usage: github-access clear packages|source-rw|--all"
      exit 2
      ;;
    *)
      fail "Unknown clear target: $target"
      usage >&2
      exit 2
      ;;
  esac
}

reject_extra_args() {
  if [[ $# -gt 0 ]]; then
    usage >&2
    exit 2
  fi
}

main() {
  require_deploy_user

  local command="${1:-setup}"
  if [[ $# -gt 0 ]]; then
    shift
  fi

  case "$command" in
    setup)
      local ci=false
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --ci)
            ci=true
            ;;
          *)
            fail "Unknown setup option: $1"
            usage >&2
            exit 2
            ;;
        esac
        shift
      done

      configure_deploy_keys
      if [[ "$ci" == "true" ]]; then
        configure_packages --write
        configure_source_rw
      else
        configure_packages
      fi
      ;;
    auth)
      reject_extra_args "$@"
      authenticate_gh
      ;;
    deploy-keys)
      reject_extra_args "$@"
      configure_deploy_keys
      ;;
    packages|npm)
      configure_packages "$@"
      ;;
    source-rw)
      reject_extra_args "$@"
      configure_source_rw
      ;;
    clear)
      clear_credentials "$@"
      ;;
    status)
      reject_extra_args "$@"
      show_status
      ;;
    help|--help|-h)
      reject_extra_args "$@"
      usage
      ;;
    *)
      fail "Unknown command: $command"
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
