#!/usr/bin/env bash
# shellcheck disable=SC1091
set -euo pipefail

# dev — Local development environment manager
#
# Usage:
#   dev              Show status
#   dev up           Start infra (Docker) + backend (air/uv/custom) + Vite (pm2)
#   dev down         Stop backend + Vite (infra is left running)
#   dev log [svc]    Tail logs: backend, vite, infra, or all (default)
#
# Run from the project root ($PWD — no discovery). Requires at least one of:
# docker-compose.yml, .air.toml, backend/.air.toml, pyproject.toml,
# backend/pyproject.toml, frontend/package.json.
# Auto-port: LISTEN_ADDR defaults to :0; the backend writes .dev/backend.port
# (Go) or the port is parsed from the uvicorn log (uv), and Vite's port is
# parsed from its log into .dev/frontend.port.
# Infra is opt-in: `dev up` starts only the compose services named in
# DEV_INFRA_SERVICES (set in .env); unset means no containers are touched.
# Backends: air (.air.toml) for Go; uv (pyproject.toml + uvicorn/fastapi,
# app at src/main.py|app/main.py|main.py — override with DEV_UV_APP) for
# Python; DEV_BACKEND_CMD as an escape hatch for anything else (requires a
# pinned LISTEN_ADDR for the health probe; DEV_HEALTH_PATH defaults to
# /healthz). Precedence: DEV_BACKEND_CMD > air > uv.
# FRONTEND_DIR may be overridden (default: frontend).

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEVD_DIR="${SCRIPT_DIR}/dev.d"

PROJECT_DIR="$PWD"

if [[ ! -f "$PROJECT_DIR/docker-compose.yml" \
   && ! -f "$PROJECT_DIR/.air.toml" \
   && ! -f "$PROJECT_DIR/backend/.air.toml" \
   && ! -f "$PROJECT_DIR/pyproject.toml" \
   && ! -f "$PROJECT_DIR/backend/pyproject.toml" \
   && ! -f "$PROJECT_DIR/frontend/package.json" ]]; then
  echo "Error: not a project root: $PROJECT_DIR" >&2
  echo "  (looked for docker-compose.yml, .air.toml, backend/.air.toml, pyproject.toml, backend/pyproject.toml, frontend/package.json)" >&2
  exit 1
fi

DETECTED_APP="$(basename "$PROJECT_DIR")"
DEV_DIR="$PROJECT_DIR/.dev"
mkdir -p "$DEV_DIR"

if [[ -f "$PROJECT_DIR/.env" ]]; then
  set -a; source "$PROJECT_DIR/.env"; set +a
fi

# Frontend dir: frontend/ by default; .env may override (e.g. FRONTEND_DIR=ui).
FRONTEND_DIR="${FRONTEND_DIR:-frontend}"
[[ "$FRONTEND_DIR" != /* ]] && FRONTEND_DIR="$PROJECT_DIR/$FRONTEND_DIR"

# Auto-port contract
export LISTEN_ADDR="${LISTEN_ADDR:-:0}"
export BACKEND_PORT_FILE="$DEV_DIR/backend.port"
export FRONTEND_PORT_FILE="$DEV_DIR/frontend.port"
# Stale port files are removed on `up` only — status/down still need them.
if [[ "${1:-}" == "up" ]]; then
  rm -f "$BACKEND_PORT_FILE" "$FRONTEND_PORT_FILE"
fi

# Initial BACKEND_PORT; the real value is re-read from the port file after
# the backend step (steps run in subshells — their exports don't propagate).
if [[ -n "${PORT:-}" ]]; then
  BACKEND_PORT="${PORT##*:}"
elif [[ "$LISTEN_ADDR" != ":0" ]]; then
  BACKEND_PORT="${LISTEN_ADDR##*:}"
else
  BACKEND_PORT="(auto)"
fi
FRONTEND_PORT="${FRONTEND_PORT:-5173}"
FRONTEND_DEV_HOST="${FRONTEND_DEV_HOST:-::}"

# Per-project pm2 daemon isolation
export PM2_HOME="${PM2_HOME:-$DEV_DIR/pm2}"

export PROJECT_DIR DEV_DIR FRONTEND_DIR DETECTED_APP LISTEN_ADDR
export BACKEND_PORT FRONTEND_PORT FRONTEND_DEV_HOST BACKEND_PORT_FILE FRONTEND_PORT_FILE

source "$DEVD_DIR/common.sh"

# --- Status ---
show_status() {
  local host infra_up=false backend_up=false vite_up=false
  local backend_port="" vite_port="" svc svc_json
  local -a infra_svcs=()
  host=$(hostname)

  # Dev's compose scope is exactly DEV_INFRA_SERVICES (.env). Deploy app
  # containers (e.g. mcp4all) are not part of the dev environment — showing
  # them as "stopped" here would be noise, so they are not listed at all.
  read -ra infra_svcs <<< "${DEV_INFRA_SERVICES:-}"

  echo "${DETECTED_APP} dev environment"
  echo "${DETECTED_APP} dev environment" | sed 's/./-/g'

  if has_compose && [[ ${#infra_svcs[@]} -gt 0 ]]; then
    for svc in "${infra_svcs[@]}"; do
      svc_json=$(compose_cmd ps "$svc" --format json 2>/dev/null || true)
      if echo "$svc_json" | grep -q '"healthy"\|"running"'; then
        infra_up=true
      fi
    done
  fi
  if [[ -f "$BACKEND_PORT_FILE" ]]; then backend_port="$(cat "$BACKEND_PORT_FILE")"; fi
  if [[ -f "$FRONTEND_PORT_FILE" ]]; then vite_port="$(cat "$FRONTEND_PORT_FILE")"; fi
  if [[ -n "$backend_port" && "$backend_port" =~ ^[0-9]+$ ]] \
      && curl -sf "http://localhost:${backend_port}${DEV_HEALTH_PATH:-/healthz}" >/dev/null 2>&1; then
    backend_up=true
  fi
  if [[ -n "$vite_port" && "$vite_port" =~ ^[0-9]+$ ]] \
      && bash -c "exec 3<>/dev/tcp/localhost/${vite_port}" 2>/dev/null; then
    vite_up=true
  fi

  if $backend_up && $vite_up; then
    echo "  ✓ running — http://${host}.local:${vite_port}"
  elif $infra_up || $backend_up || $vite_up; then
    echo "  ● partially running"
  else
    echo "  ✗ stopped"
  fi
  echo ""

  if has_compose && [[ ${#infra_svcs[@]} -gt 0 ]]; then
    for svc in "${infra_svcs[@]}"; do
      svc_json=$(compose_cmd ps "$svc" --format json 2>/dev/null || true)
      if echo "$svc_json" | grep -q '"healthy"'; then
        printf '  %-10s ✓ running (healthy)\n' "$svc"
      elif echo "$svc_json" | grep -q '"running"'; then
        printf '  %-10s ● running (starting)\n' "$svc"
      else
        printf '  %-10s ✗ stopped\n' "$svc"
      fi
    done
  fi

  report_svc() {
    if [[ "$2" == true ]]; then printf '  %-10s ✓ running on :%s\n' "$1" "$3"
    else printf '  %-10s ✗ not responding%s\n' "$1" "${3:+ on :$3}"; fi
  }
  report_svc backend "$backend_up" "$backend_port"
  report_svc vite "$vite_up" "$vite_port"

  echo ""
  echo "Commands:"
  echo "  dev up         Start everything"
  echo "  dev down       Stop everything"
  echo "  dev log [svc]  Tail logs (backend, vite, infra, all)"
  echo ""
}

# --- Up ---
dev_up() {
  local step
  for step in 10-infra 40-air 42-uv 45-backend 50-vite; do
    if ! bash "$DEVD_DIR/${step}.sh" up; then
      fail "Step ${step} failed — stopping"
      return 1
    fi
    # Steps ran in subshells — re-read resolved ports so later steps see them.
    if [[ -f "$BACKEND_PORT_FILE" ]]; then
      BACKEND_PORT="$(cat "$BACKEND_PORT_FILE")"; export BACKEND_PORT
    fi
    if [[ "$step" == "50-vite" && -f "$FRONTEND_PORT_FILE" ]]; then
      FRONTEND_PORT="$(cat "$FRONTEND_PORT_FILE")"; export FRONTEND_PORT
    fi
  done
  echo ""
  show_status
}

# --- Down ---
dev_down() {
  log "Stopping dev environment..."

  # Capture ports before step teardown deletes the port files.
  local backend_port="" vite_port=""
  if [[ -f "$BACKEND_PORT_FILE" ]]; then backend_port="$(cat "$BACKEND_PORT_FILE")"; fi
  if [[ -f "$FRONTEND_PORT_FILE" ]]; then vite_port="$(cat "$FRONTEND_PORT_FILE")"; fi

  local step
  for step in 50-vite 45-backend 42-uv 40-air 10-infra; do
    bash "$DEVD_DIR/${step}.sh" down || true
  done

  # Fallback: kill user-owned processes still holding the ports.
  local port pids
  for port in "$backend_port" "$vite_port"; do
    if [[ -n "$port" && "$port" =~ ^[0-9]+$ ]]; then
      pids=$(own_port_pids "$port")
      if [[ -n "$pids" ]]; then
        echo "$pids" | xargs kill 2>/dev/null || true
      fi
    fi
  done

  if has_compose && compose_cmd ps --status running --services 2>/dev/null | grep -q .; then
    echo ""
    echo "  ℹ Docker services left running — use 'stack down' to stop them."
  fi

  ok "Dev processes stopped"
}

# --- Log ---
dev_log() {
  local svc="${1:-all}"
  local pids=()

  cleanup() {
    local p
    for p in "${pids[@]}"; do
      kill "$p" 2>/dev/null || true
    done
    exit
  }
  trap cleanup INT TERM

  case "$svc" in
    vite)
      [[ -f "$DEV_DIR/vite.log" ]] || { fail "No Vite log found. Run 'dev up' first."; exit 1; }
      tail -F "$DEV_DIR/vite.log" | sed -u 's/^/vite    ~ /'
      ;;
    backend|be)
      [[ -f "$DEV_DIR/backend.log" ]] || { fail "No backend log found. Run 'dev up' first."; exit 1; }
      tail -F "$DEV_DIR/backend.log" | sed -u 's/^/backend ~ /'
      ;;
    infra)
      if has_compose; then
        compose_cmd logs -f 2>/dev/null | sed -u 's/^/infra   | /'
      else
        fail "No compose file found."
        exit 1
      fi
      ;;
    all|"")
      if [[ -f "$DEV_DIR/vite.log" ]]; then tail -F "$DEV_DIR/vite.log" 2>/dev/null | sed -u 's/^/vite    ~ /' & pids+=($!); fi
      if [[ -f "$DEV_DIR/backend.log" ]]; then tail -F "$DEV_DIR/backend.log" 2>/dev/null | sed -u 's/^/backend ~ /' & pids+=($!); fi
      if has_compose; then compose_cmd logs -f --no-log-prefix 2>/dev/null | sed -u 's/^/infra   | /' & pids+=($!); fi
      wait
      ;;
    *)
      fail "Unknown log target: $svc (expected: backend, vite, infra, all)"
      exit 1
      ;;
  esac
}

# --- Main ---
case "${1:-}" in
  up)    dev_up ;;
  down)  dev_down ;;
  log)   dev_log "${2:-}" ;;
  logs)  dev_log all ;;
  "")    show_status ;;
  *)
    fail "Unknown command: $1"
    echo "Usage: dev [up|down|log [svc]|logs]" >&2
    exit 1
    ;;
esac
