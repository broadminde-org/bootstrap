# GitHub Packages npm/GHCR auth (read by user/init.d/98-npm-shared)
# Classic PAT. Normal dev hosts need read:packages; publish hosts also need
# write:packages. Preferred setup: ~/scripts/github-access packages [--write]
# BROADMINDE_PACKAGES_TOKEN=ghp_...

# Legacy fallback accepted by 98-npm-shared. Prefer BROADMINDE_PACKAGES_TOKEN.
# GITHUB_PACKAGES_TOKEN=ghp_...

# Optional source read/write automation PAT for update/test/CI hosts.
# Classic PAT scopes: repo, workflow. Configure with:
#   ~/scripts/github-access source-rw
# BROADMINDE_SOURCE_RW_TOKEN=ghp_...
